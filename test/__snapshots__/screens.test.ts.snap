exports[`screen: 'help' > en 40 plain 1`] = `
"  B L A D E C P   CLI  v0.3.2
 ──────────────────────────────────────
  Migrate, manage and ship on BladeCP
  from your terminal.

  Usage: bladecp <command> [options]

  Account ─────────────────────────────
  login
    Sign in with your browser or an API
    key
  logout
    Remove the saved sign-in from this
    computer
  whoami
    Show the account and key in use

  Servers ─────────────────────────────
  servers list
    List your servers
  servers show <uuid>
    Show a server and its resource
    usage
  destinations list
    List the plans and locations
    available for migrations

  Migrations ──────────────────────────
  analyze <backup.tar.gz>
    See what a cPanel backup holds and
    what comes to BladeCP, on this
    computer
  migrate <backup.tar.gz>
    Upload a cPanel backup and migrate
    the site to BladeCP
  migrations list
    List your migrations
  migrations status <uuid>
    Show a migration (add --watch to
    follow it)
  migrations review <uuid>
    Confirm which domain a migration
    uses
  migrations approve <uuid>
    Approve a migration after checking
    the preview
  migrations cancel <uuid>
    Cancel a migration
  migrations retry <uuid>
    Try a failed migration again

  CLI ─────────────────────────────────
  update
    Update the CLI to the latest
    version
  config list
    Show your preferences
  config get <key>
    Show one preference
  config set <key> <value>
    Change a preference

  Examples ────────────────────────────
  › bladecp login
    sign in with the browser
  › bladecp analyze cpmove-site.tar.gz
    check a backup before migrating,
    offline
  › bladecp migrate cpmove-site.tar.gz
    migrate with the guided wizard
  › bladecp migrate cpmove-site.tar.gz
    --yes --json
    migrate without questions, for CI
  › bladecp migrations status <uuid>
    --watch
    follow until it needs you

  Global options ──────────────────────
  --json
    Print machine-readable JSON (no
    colors, no prompts)
  --api-url <url>
    API address (default
    https://api.bladecp.com)
  --lang <en|pt-BR|es>
    Language for messages
  --debug
    Describe each request on stderr
    (the key is never shown)
  --verbose
    Same as --debug
  -h, --help
    Show help
  -v, --version
    Show the version

  Environment ─────────────────────────
  BLADECP_API_KEY
    API key to use instead of the saved
    sign-in
  BLADECP_API_URL
    API address (same as --api-url)
  BLADECP_HUB_URL
    Hub address for the sign-in and
    links (default: the Hub of the API
    address)
  BLADECP_CONFIG_DIR
    Folder for the saved sign-in,
    preferences and upload progress
  BLADECP_NO_UPDATE_CHECK
    Set to 1 to never check for a new
    version (NO_UPDATE_NOTIFIER also
    works)
  BLADECP_MOTION
    off shows the B without animation;
    reduced shows only its last frame
  NO_COLOR
    Turns colors off when set to any
    value
  FORCE_COLOR
    Forces colors (1, 2 or 3 for the
    depth) or turns them off (0)
  CI
    In CI the CLI never asks questions
    and never animates

  Exit codes ──────────────────────────
    0 ok
    1 unexpected error
    2 invalid usage
    3 sign-in needed
    4 permission denied
    5 not found
    6 rejected by the API
    7 rate limited
    8 network or server error
    9 migration failed or cancelled
   10 waiting for your action
   11 update required
  130 interrupted

  For scripts and agents: --json on any
  command returns one JSON document,
  with no colors and no prompts.

  Run "bladecp <command> --help" for
  details, or read
  https://developers.bladecp.com/cli"
`;

exports[`screen: 'help' > en 80 color 1`] = `
"  B L A D E C P   CLI  v0.3.2
 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━────────────────────────────────────────────────
  Migrate, manage and ship on BladeCP from your terminal.

  Usage: bladecp <command> [options]

  Account ────────────────────────────────────
  login                       Sign in with your browser or an API key
  logout                      Remove the saved sign-in from this computer
  whoami                      Show the account and key in use

  Servers ────────────────────────────────────
  servers list                List your servers
  servers show <uuid>         Show a server and its resource usage
  destinations list           List the plans and locations available for
                              migrations

  Migrations ─────────────────────────────────
  analyze <backup.tar.gz>     See what a cPanel backup holds and what comes to
                              BladeCP, on this computer
  migrate <backup.tar.gz>     Upload a cPanel backup and migrate the site to
                              BladeCP
  migrations list             List your migrations
  migrations status <uuid>    Show a migration (add --watch to follow it)
  migrations review <uuid>    Confirm which domain a migration uses
  migrations approve <uuid>   Approve a migration after checking the preview
  migrations cancel <uuid>    Cancel a migration
  migrations retry <uuid>     Try a failed migration again

  CLI ────────────────────────────────────────
  update                      Update the CLI to the latest version
  config list                 Show your preferences
  config get <key>            Show one preference
  config set <key> <value>    Change a preference

  Examples ───────────────────────────────────
  › bladecp login
    sign in with the browser
  › bladecp analyze cpmove-site.tar.gz
    check a backup before migrating, offline
  › bladecp migrate cpmove-site.tar.gz
    migrate with the guided wizard
  › bladecp migrate cpmove-site.tar.gz --yes --json
    migrate without questions, for CI
  › bladecp migrations status <uuid> --watch
    follow until it needs you

  Global options ─────────────────────────────
  --json                 Print machine-readable JSON (no colors, no prompts)
  --api-url <url>        API address (default https://api.bladecp.com)
  --lang <en|pt-BR|es>   Language for messages
  --debug                Describe each request on stderr (the key is never
                         shown)
  --verbose              Same as --debug
  -h, --help             Show help
  -v, --version          Show the version

  Environment ────────────────────────────────
  BLADECP_API_KEY           API key to use instead of the saved sign-in
  BLADECP_API_URL           API address (same as --api-url)
  BLADECP_HUB_URL           Hub address for the sign-in and links (default: the
                            Hub of the API address)
  BLADECP_CONFIG_DIR        Folder for the saved sign-in, preferences and
                            upload progress
  BLADECP_NO_UPDATE_CHECK   Set to 1 to never check for a new version
                            (NO_UPDATE_NOTIFIER also works)
  BLADECP_MOTION            off shows the B without animation; reduced shows
                            only its last frame
  NO_COLOR                  Turns colors off when set to any value
  FORCE_COLOR               Forces colors (1, 2 or 3 for the depth) or turns
                            them off (0)
  CI                        In CI the CLI never asks questions and never
                            animates

  Exit codes ─────────────────────────────────
    0 ok                                 7 rate limited
    1 unexpected error                   8 network or server error
    2 invalid usage                      9 migration failed or cancelled
    3 sign-in needed                    10 waiting for your action
    4 permission denied                 11 update required
    5 not found                        130 interrupted
    6 rejected by the API

  For scripts and agents: --json on any command returns one JSON document, with
  no colors and no prompts.

  Run "bladecp <command> --help" for details, or read
