exports[`screen: 'help' > es 120 plain 1`] = `
"  B L A D E C P   CLI  v0.3.2
 ──────────────────────────────────────────────────────────────────────────────
  Migra, gestiona y publica en BladeCP desde tu terminal.

  Uso: bladecp <comando> [opciones]

  Cuenta ─────────────────────────────────────
  login                       Iniciar sesión con el navegador o con una clave de API
  logout                      Quitar el inicio de sesión guardado en esta computadora
  whoami                      Mostrar la cuenta y la clave en uso

  Servidores ─────────────────────────────────
  servers list                Listar tus servidores
  servers show <uuid>         Mostrar un servidor y su uso de recursos
  destinations list           Listar los planes y ubicaciones disponibles para migraciones

  Migraciones ────────────────────────────────
  analyze <backup.tar.gz>     Ver qué tiene un respaldo de cPanel y qué llega a BladeCP, en este
                              equipo
  migrate <backup.tar.gz>     Subir un respaldo de cPanel y migrar el sitio a BladeCP
  migrations list             Listar tus migraciones
  migrations status <uuid>    Mostrar una migración (usa --watch para seguirla)
  migrations review <uuid>    Confirmar el dominio de una migración
  migrations approve <uuid>   Aprobar una migración después de revisar la vista previa
  migrations cancel <uuid>    Cancelar una migración
  migrations retry <uuid>     Reintentar una migración que falló

  CLI ────────────────────────────────────────
  update                      Actualizar la CLI a la versión más reciente
  config list                 Mostrar tus preferencias
  config get <key>            Mostrar una preferencia
  config set <key> <value>    Cambiar una preferencia

  Ejemplos ───────────────────────────────────
  › bladecp login
    iniciar sesión con el navegador
  › bladecp analyze cpmove-site.tar.gz
    revisar un respaldo antes de migrar, sin internet
  › bladecp migrate cpmove-site.tar.gz
    migrar con el asistente
  › bladecp migrate cpmove-site.tar.gz --yes --json
    migrar sin preguntas, para CI
  › bladecp migrations status <uuid> --watch
    seguir hasta que te necesite

  Opciones globales ──────────────────────────
  --json                 Imprimir JSON para máquinas (sin colores ni preguntas)
  --api-url <url>        Dirección de la API (predeterminada https://api.bladecp.com)
  --lang <en|pt-BR|es>   Idioma de los mensajes
  --debug                Describir cada solicitud en stderr (la clave nunca aparece)
  --verbose              Lo mismo que --debug
  -h, --help             Mostrar la ayuda
  -v, --version          Mostrar la versión

  Entorno ────────────────────────────────────
  BLADECP_API_KEY           Clave de API que se usa en lugar del inicio de sesión guardado
  BLADECP_API_URL           Dirección de la API (igual que --api-url)
  BLADECP_HUB_URL           Dirección del Hub para el inicio de sesión y los enlaces (por defecto:
                            el Hub de la API)
  BLADECP_CONFIG_DIR        Carpeta del inicio de sesión guardado, las preferencias y el progreso
                            de las subidas
  BLADECP_NO_UPDATE_CHECK   Con 1, nunca busca una versión nueva (NO_UPDATE_NOTIFIER también sirve)
  BLADECP_MOTION            off muestra la B sin animación; reduced muestra solo su último cuadro
  NO_COLOR                  Apaga los colores con cualquier valor
  FORCE_COLOR               Fuerza los colores (1, 2 o 3 para la profundidad) o los apaga (0)
  CI                        En CI la CLI nunca pregunta y nunca anima

  Códigos de salida ──────────────────────────
    0 ok                                 7 límite de solicitudes
    1 error inesperado                   8 error de red o del servidor
    2 uso no válido                      9 migración fallida o cancelada
    3 inicio de sesión necesario        10 esperando una acción tuya
    4 sin permiso                       11 actualización necesaria
    5 no encontrado                    130 interrumpido
    6 rechazado por la API

  Para scripts y agentes: --json en cualquier comando devuelve un único JSON, sin colores ni
  preguntas.

  Ejecuta "bladecp <command> --help" para ver los detalles, o lee
  https://developers.bladecp.com/cli"
`;

exports[`screen: 'help' > pt-BR 40 color 1`] = `
"  B L A D E C P   CLI  v0.3.2
 ━━━━━━━━━━━━━━━───────────────────────
  Migre, gerencie e publique na BladeCP
  direto do terminal.

  Uso: bladecp <comando> [opções]

  Conta ───────────────────────────────
  login
    Entrar pelo navegador ou com uma
    chave de API
  logout
    Remover o login salvo neste
    computador
  whoami
    Mostrar a conta e a chave em uso

  Servidores ──────────────────────────
  servers list
    Listar seus servidores
  servers show <uuid>
    Mostrar um servidor e o uso de
    recursos
  destinations list
    Listar os planos e locais
    disponíveis para migração

  Migrações ───────────────────────────
  analyze <backup.tar.gz>
    Ver o que um backup do cPanel tem e
    o que vem para a BladeCP, neste
    computador
  migrate <backup.tar.gz>
    Enviar um backup do cPanel e migrar
    o site para a BladeCP
  migrations list
    Listar suas migrações
  migrations status <uuid>
    Mostrar uma migração (use --watch
    para acompanhar)
  migrations review <uuid>
    Confirmar o domínio de uma migração
  migrations approve <uuid>
    Aprovar uma migração depois de
    conferir a prévia
  migrations cancel <uuid>
    Cancelar uma migração
  migrations retry <uuid>
    Tentar de novo uma migração que
    falhou

  CLI ─────────────────────────────────
  update
    Atualizar a CLI para a versão mais
    recente
  config list
    Mostrar suas preferências
  config get <key>
    Mostrar uma preferência
  config set <key> <value>
    Mudar uma preferência

  Exemplos ────────────────────────────
  › bladecp login
    entrar pelo navegador
  › bladecp analyze cpmove-site.tar.gz
    conferir um backup antes de migrar,
    sem internet
  › bladecp migrate cpmove-site.tar.gz
    migrar com o assistente
  › bladecp migrate cpmove-site.tar.gz
    --yes --json
    migrar sem perguntas, para CI
  › bladecp migrations status <uuid>
    --watch
    acompanhar até precisar de você

  Opções globais ──────────────────────
  --json
    Imprimir JSON para máquinas (sem
    cores e sem perguntas)
  --api-url <url>
    Endereço da API (padrão
    https://api.bladecp.com)
  --lang <en|pt-BR|es>
    Idioma das mensagens
  --debug
    Descrever cada requisição no stderr
    (a chave nunca aparece)
  --verbose
    O mesmo que --debug
  -h, --help
    Mostrar a ajuda
  -v, --version
    Mostrar a versão

  Ambiente ────────────────────────────
  BLADECP_API_KEY
    Chave de API usada no lugar do
    login salvo
  BLADECP_API_URL
    Endereço da API (o mesmo que
    --api-url)
  BLADECP_HUB_URL
    Endereço do Hub para o login e os
    links (padrão: o Hub do endereço da
    API)
  BLADECP_CONFIG_DIR
    Pasta do login salvo, das
    preferências e do progresso dos
    envios
  BLADECP_NO_UPDATE_CHECK
    Com 1, nunca procura versão nova
    (NO_UPDATE_NOTIFIER também vale)
  BLADECP_MOTION
    off mostra o B sem animação;
    reduced mostra só o último quadro
  NO_COLOR
    Desliga as cores com qualquer valor
  FORCE_COLOR
    Força as cores (1, 2 ou 3 para a
    profundidade) ou as desliga (0)
  CI
    Em CI a CLI nunca pergunta nada e
    nunca anima

  Códigos de saída ────────────────────
    0 ok
    1 erro inesperado
    2 uso inválido
    3 login necessário
    4 sem permissão
    5 não encontrado
    6 recusado pela API
    7 limite de requisições
    8 erro de rede ou do servidor
    9 migração com falha ou cancelada
   10 aguardando uma ação sua
   11 atualização necessária
  130 interrompido

  Para scripts e agentes: --json em
  qualquer comando devolve um único
  JSON, sem cor e sem perguntas.

  Rode "bladecp <command> --help" para
  ver os detalhes, ou leia
  https://developers.bladecp.com/cli

