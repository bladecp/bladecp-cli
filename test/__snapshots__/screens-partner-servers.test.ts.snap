exports[`screen: 'help partner servers create' > en 120 plain 1`] = `
"  bladecp partner servers create
 ──────────────────────────────────────────────────────────────────────────────
  Creates a server for one of your customers, as your billing system does when a service is
  ordered: a plan and a location of your catalog, the main domain and the customer who owns it. On
  a terminal it asks first; --yes skips the question.

  Usage ──────────────────────────────────────
  bladecp partner servers create --plan <id> --location <id> --domain <host> --email <email> --name
      <name> [--external-id <id>] [--option <id>=<value>] ... [--component <slug>] ...
      [--contract <months>] [--yes]

  Options ────────────────────────────────────
  --plan <id>                      Plan ID (see "bladecp partner plans")
  --location <id>                  Location ID of the plan (see "bladecp partner locations")
  --domain <host>                  Main domain of the new server
  --email <email>                  Email of the customer who owns the server
  --name <name>                    Name of the customer who owns the server
  --external-id <id>               The service ID in your billing system, to find the server later
  --option <id>=<value>            Configurable option and value, by name or ID (see "bladecp
                                   partner options"); for a quantity, the number. Repeat for more
                                   than one
  --component <slug>[@<version>]   Component to install, with an optional version (repeat for more
                                   than one)
  --contract <months>              Contract term in months (12, 24, 36 or 48) for plans sold with a
                                   contract; records that the customer accepted the terms
  -y, --yes                        Do not ask for confirmation on a terminal

  With --external-id the server keeps the service ID of your billing system, so "bladecp partner
  servers list --external-id" finds it later.
  Stack Container plans need the components to install (for example --component php --component
  mysql, or a version from "bladecp components list" after @). A web server always comes along:
  NGINX by default, or another one, such as --component apache. Other products take none.

  Examples ───────────────────────────────────
  › bladecp partner servers create --plan 12 --location 3 --domain example.com --email owner@example.com --name "Example
    Shop" --external-id 1042
    A server on plan 12, location 3, for a customer
  › bladecp partner servers create --plan 12 --location 3 --domain example.com --email owner@example.com --name "Example
    Shop" --option memory=4 --component php --component mysql
    With more memory and the PHP component

  Global options ─────────────────────────────
  --json                 Print machine-readable JSON (no colors, no prompts)
  --api-url <url>        API address (default https://api.bladecp.com)
  --lang <en|pt-BR|es>   Language for messages
  --debug                Describe each request on stderr (the key is never shown)
  --verbose              Same as --debug
  -h, --help             Show help
  -v, --version          Show the version

  See also  bladecp partner plans · bladecp partner locations · bladecp partner options"
`;

exports[`screen: 'help partner servers create' > es 40 color 1`] = `
"  bladecp partner servers create
 ━━━━━━━━━━━━──────────────────────────
  Crea un servidor para uno de tus
  clientes, como lo hace tu sistema de
  cobro cuando se contrata un servicio:
  un plan y una ubicación de tu
  catálogo, el dominio principal y el
  cliente dueño. En una terminal
  pregunta antes; --yes omite la
  pregunta.

  Uso ──────────────────────────────────
  bladecp partner servers create --plan
      <id> --location <id> --domain
      <host> --email <email> --name
      <name> [--external-id <id>]
      [--option <id>=<value>] ...
      [--component <slug>] ...
      [--contract <months>] [--yes]

  Opciones ────────────────────────────
  --plan <id>
    ID del plan (mira "bladecp partner
    plans")
  --location <id>
    ID de la ubicación del plan (mira
    "bladecp partner locations")
  --domain <host>
    Dominio principal del nuevo
    servidor
  --email <email>
    Correo del cliente dueño del
    servidor
  --name <name>
    Nombre del cliente dueño del
    servidor
  --external-id <id>
    El ID del servicio en tu sistema de
    cobro, para encontrar el servidor
    después
  --option <id>=<value>
    Opción configurable y valor, por
    nombre o ID (mira "bladecp partner
    options"); en una cantidad, el
    número. Repite para más de una
  --component <slug>[@<version>]
    Componente a instalar, con la
    versión si quieres (repite para más
    de uno)
  --contract <months>
    Plazo del contrato en meses (12,
    24, 36 o 48) para planes vendidos
    con contrato; registra que el
    cliente aceptó los términos
  -y, --yes
    No pedir confirmación en la
    terminal

  Con --external-id, el servidor guarda
  el ID del servicio de tu sistema de
  cobro, y "bladecp partner servers
  list --external-id" lo encuentra
  después.
  Los planes Stack Container necesitan
  los componentes a instalar (por
  ejemplo --component php --component
  mysql, o una versión de "bladecp
  components list" después de @). Un
  servidor web siempre va incluido:
  NGINX por defecto, u otro, como
  --component apache. Los demás
  productos no llevan componentes.

  Ejemplos ────────────────────────────
  › bladecp partner servers create
    --plan 12 --location 3 --domain
    example.com --email
    owner@example.com --name "Example
    Shop" --external-id 1042
    Un servidor en el plan 12,
    ubicación 3, para un cliente
  › bladecp partner servers create
    --plan 12 --location 3 --domain
    example.com --email
    owner@example.com --name "Example
    Shop" --option memory=4 --component
    php --component mysql
    Con más memoria y el componente PHP

  Opciones globales ───────────────────
  --json
    Imprimir JSON para máquinas (sin
    colores ni preguntas)
  --api-url <url>
    Dirección de la API (predeterminada
    https://api.bladecp.com)
  --lang <en|pt-BR|es>
    Idioma de los mensajes
  --debug
    Describir cada solicitud en stderr
    (la clave nunca aparece)
  --verbose
    Lo mismo que --debug
  -h, --help
    Mostrar la ayuda
  -v, --version
    Mostrar la versión

  Ver también  bladecp partner plans ·
  bladecp partner locations · bladecp
  partner options

