// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`screen: 'help partner migrations show' > en 40 color 1`] = `
"  bladecp partner migrations show
  <request>
 ━━━━━━━━━━━━──────────────────────────
  The phase of the migration, its
  components, the preview address, the
  billing link and the payment, and
  what to do next. With --watch, it
  follows the request until it needs
  someone or ends.

  Usage ────────────────────────────────
  bladecp partner migrations show
      <request> --installation <id>
      --client <id> [--watch]

  Arguments ───────────────────────────
  <request>   The request ID, or its
              first characters (at
              least 4) when only one
              request of the client
              starts with them.

  Options ─────────────────────────────
  --installation <id>
    The WHMCS installation that made
    the request (its BladeCP
    installation ID, a UUID)
  --client <id>
    The client of that installation the
    request belongs to (its client ID
    in WHMCS)
  -w, --watch
    Keep following the request until it
    needs someone or ends

  A request is named by the WHMCS
  installation and the client that made
  it: --installation is the BladeCP
  installation ID of that WHMCS, and
  --client the client ID in it. The
  BladeCP WHMCS module sends the same
  values.

  Examples ────────────────────────────
  › bladecp partner migrations show
    01979f2c-0000-7000-8000-000000000002
    --installation
    01980000-0000-7000-8000-0000000000a1
    --client 42
    Phase, preview and billing of a
    request
  › bladecp partner migrations show
    01979f2c --installation
    01980000-0000-7000-8000-0000000000a1
    --client 42 --watch
    Follow it until it needs someone or
    ends

  Exit codes ──────────────────────────
    0 preview ready or migration
      complete
    9 the migration failed or was
      cancelled
   10 waits for someone (the domain,
      the backup or the billing link)

  Global options ──────────────────────
  --json
    Print machine-readable JSON (no
    colors, no prompts)
  --api-url <url>
    API address (default
    https://api.bladecp.com)
  --lang <en|pt-BR|es>
    Language for messages
  --debug
    Describe each request on stderr
    (the key is never shown)
  --verbose
    Same as --debug
  -h, --help
    Show help
  -v, --version
    Show the version

