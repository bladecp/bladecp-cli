exports[`screen: 'help partner migrations' > en 40 color 1`] = `
"  bladecp partner migrations
 ━━━━━━━━━━━━──────────────────────────
  Run Fast Deploy for your clients:
  WHMCS requests, billing queue and
  account confirmation

  Usage: bladecp partner migrations
  <command> [options]

  Commands ────────────────────────────
  list
    List the Fast Deploy requests of a
    WHMCS installation
  show <request>
    Show a request: phase, components,
    preview and billing
  review <request>
    Confirm the domain of the site
    found in the backup
  approve <request>
    Approve the preview so BladeCP
    finishes the migration
  cancel <request>
    Cancel a request that is not
    approved yet
  retry <request>
    Try a failed migration again, when
    that is safe
  billing-queue
    List the requests waiting for the
    billing WHMCS
  billing-link <request>
    Link a request to its client and
    service in the billing WHMCS
  claim-url <request>
    Get the address where the account
    holder confirms the account

