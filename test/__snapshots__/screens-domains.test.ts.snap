exports[`screen: 'help domains add' > en 80 plain 1`] = `
"  bladecp domains add <server> <host>
 ──────────────────────────────────────────────────────────────────────────────
  Adds a domain to a server, next to its main domain. The site answers at the
  new address once the DNS of the domain points to BladeCP.

  Usage ──────────────────────────────────────
  bladecp domains add <server> <host>

  Arguments ──────────────────────────────────
  <server>   The server: its ID, or its first characters (at least 4).
  <host>     The domain, for example blog.example.com.

  Examples ───────────────────────────────────
  › bladecp domains check blog.example.com
    Check a domain before you add it
  › bladecp domains add 0197a1c4 blog.example.com
    Add another domain to it

  Global options ─────────────────────────────
  --json                 Print machine-readable JSON (no colors, no prompts)
  --api-url <url>        API address (default https://api.bladecp.com)
  --lang <en|pt-BR|es>   Language for messages
  --debug                Describe each request on stderr (the key is never
                         shown)
  --verbose              Same as --debug
  -h, --help             Show help
  -v, --version          Show the version

  See also  bladecp domains list <server>"
`;

