exports[`screen: 'help domains add' > es 80 plain 1`] = `
"  bladecp domains add <server> <host>
 ──────────────────────────────────────────────────────────────────────────────
  Agrega un dominio a un servidor, junto a su dominio principal. El sitio
  responde en la nueva dirección cuando el DNS del dominio apunta a BladeCP.

  Uso ────────────────────────────────────────
  bladecp domains add <server> <host>

  Argumentos ─────────────────────────────────
  <server>   El servidor: su ID, o sus primeros caracteres (al menos 4).
  <host>     El dominio, por ejemplo blog.example.com.

  Ejemplos ───────────────────────────────────
  › bladecp domains check blog.example.com
    Comprobar un dominio antes de agregarlo
  › bladecp domains add 0197a1c4 blog.example.com
    Agregarle otro dominio

  Opciones globales ──────────────────────────
  --json                 Imprimir JSON para máquinas (sin colores ni preguntas)
  --api-url <url>        Dirección de la API (predeterminada
                         https://api.bladecp.com)
  --lang <en|pt-BR|es>   Idioma de los mensajes
  --debug                Describir cada solicitud en stderr (la clave nunca
                         aparece)
  --verbose              Lo mismo que --debug
  -h, --help             Mostrar la ayuda
  -v, --version          Mostrar la versión

  Ver también  bladecp domains list <server>"
`;

