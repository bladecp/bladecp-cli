exports[`screen: 'help domains add' > pt-BR 80 plain 1`] = `
"  bladecp domains add <server> <host>
 ──────────────────────────────────────────────────────────────────────────────
  Adiciona um domínio a um servidor, ao lado do domínio principal. O site
  responde no novo endereço quando o DNS do domínio aponta para a BladeCP.

  Uso ────────────────────────────────────────
  bladecp domains add <server> <host>

  Argumentos ─────────────────────────────────
  <server>   O servidor: o ID dele, ou os primeiros caracteres (pelo menos 4).
  <host>     O domínio, por exemplo blog.example.com.

  Exemplos ───────────────────────────────────
  › bladecp domains check blog.example.com
    Conferir um domínio antes de adicioná-lo
  › bladecp domains add 0197a1c4 blog.example.com
    Adicionar mais um domínio a ele

  Opções globais ─────────────────────────────
  --json                 Imprimir JSON para máquinas (sem cores e sem
                         perguntas)
  --api-url <url>        Endereço da API (padrão https://api.bladecp.com)
  --lang <en|pt-BR|es>   Idioma das mensagens
  --debug                Descrever cada requisição no stderr (a chave nunca
                         aparece)
  --verbose              O mesmo que --debug
  -h, --help             Mostrar a ajuda
  -v, --version          Mostrar a versão

  Veja também  bladecp domains list <server>"
`;

