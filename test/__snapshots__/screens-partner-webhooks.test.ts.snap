// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`screen: 'help partner webhooks create' > en 40 color 1`] = `
"  bladecp partner webhooks create
 ━━━━━━━━━━━━──────────────────────────
  Adds an HTTPS address that receives
  the events you choose. The signing
  secret shows only once: store it in
  your system to check the
  BladeCP-Signature header of each
  delivery against the exact body.

  Usage ────────────────────────────────
  bladecp partner webhooks create --url
      <url> --event <type>...
      [--name <name>]

  Options ─────────────────────────────
  --url <url>
    Address that receives the events
    (https)
  --event <type>
    Event type to send (repeat it, or
    separate with commas)
  --name <name>
    A name to tell the endpoint apart
    (for example Production WHMCS)

  Event types: provision.created,
  provision.status.changed,
  provision.suspended,
  provision.unsuspended,
  provision.terminated, invoice.paid,
  invoice.failed,
  subscription.upgraded,
  subscription.downgraded,
  vibe.account.activated,
  vibe.account.plan_changed,
  vibe.account.suspended,
  vibe.account.reactivated,
  vibe.account.terminated.
  Each event has a stable ID. A
  delivery can arrive more than once,
  so your system should skip an ID it
  already processed.

  Examples ────────────────────────────
  › bladecp partner webhooks create
    --url
    https://billing.example.com/bladecp
    --event invoice.paid --event
    provision.created --name "Production
    WHMCS"
    send paid invoices and new services
    to your billing system

  Global options ──────────────────────
  --json
    Print machine-readable JSON (no
    colors, no prompts)
  --api-url <url>
    API address (default
    https://api.bladecp.com)
  --lang <en|pt-BR|es>
    Language for messages
  --debug
    Describe each request on stderr
    (the key is never shown)
  --verbose
    Same as --debug
  -h, --help
    Show help
  -v, --version
    Show the version

  See also  bladecp partner webhooks
  rotate-secret <endpoint>

--- styles ---
0: 2-8 B | 10-16 B | 18-25 B | 27-32 B
1: 1-1 f6264f0 | 2-2 f7c74f4 | 3-3 f9b84f8 | 4-4 fbba6fb | 5-5 fddd4fd | 6-6 fd9cefd | 7-7 fb7a1fb | 8-8 f9782f8 | 9-9 f7972f4 | 10-10 f6163f0 | 11-11 f5956eb | 12-12 f524ae7 | 13-13 f4941d0 | 14-14 f3f39b0 | 15-15 f363292 | 16-16 f2f2c79 | 17-17 f2a2863 | 18-18 f262451 | 19-19 f222141 | 20-20 f1f1f35 | 21-21 f1d1d2c | 22-38 f1c1c28
